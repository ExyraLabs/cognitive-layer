{
  "name": "exyra-cognitive-layer",
  "version": "1.0.0",
  "description": "Exyra's self-optimizing reasoning engine for real-time DeFi decision making",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc && node scripts/post-build.cjs",
    "start": "node dist/index.js",
    "test": "vitest",
    "test:watch": "vitest --watch",
    "lint": "eslint src --ext .ts,.tsx --fix",
    "type-check": "tsc --noEmit",
    "cognitive:simulate": "tsx src/examples/simulate.ts",
    "cognitive:benchmark": "tsx src/examples/benchmark.ts"
  },
  "keywords": [
    "ai",
    "defi",
    "cognitive",
    "reasoning",
    "autonomous",
    "blockchain",
    "optimization"
  ],
  "author": "Exyra Labs",
  "license": "MIT",
  "dependencies": {
    "@types/node": "^20.10.0",
    "axios": "^1.6.0",
    "dotenv": "^16.3.0",
    "ethers": "^6.15.0",
    "eventemitter3": "^5.0.1",
    "lodash": "^4.17.21",
    "uuid": "^9.0.1",
    "ws": "^8.14.0"
  },
  "devDependencies": {
    "@types/lodash": "^4.14.200",
    "@types/uuid": "^9.0.7",
    "@types/ws": "^8.5.9",
    "@typescript-eslint/eslint-plugin": "^6.12.0",
    "@typescript-eslint/parser": "^6.12.0",
    "eslint": "^8.54.0",
    "tsx": "^4.6.0",
    "typescript": "^5.9.2",
    "vitest": "^1.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
